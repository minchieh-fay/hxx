services:
  codex:
    image: codex-web:latest
    container_name: codex-app-server
    restart: unless-stopped
    environment:
      CODEX_HOME: /codex-home
      OPENAI_API_KEY: "${OPENAI_API_KEY:?Set OPENAI_API_KEY in .env}"
      HTTP_PROXY: "${CODEX_HTTP_PROXY:-}"
      HTTPS_PROXY: "${CODEX_HTTPS_PROXY:-}"
      NO_PROXY: "${CODEX_NO_PROXY:-localhost,127.0.0.1,::1}"
      http_proxy: "${CODEX_HTTP_PROXY:-}"
      https_proxy: "${CODEX_HTTPS_PROXY:-}"
      no_proxy: "${CODEX_NO_PROXY:-localhost,127.0.0.1,::1}"
    volumes:
      - ./codex-bin:/opt/codex:ro
      - ./home:/codex-home
      - ./workspace:/workspaces
      - ./secrets/app-server-token:/run/secrets/codex-ws-token:ro
    networks:
      app-net:
        aliases:
          - "${CODEX_SERVICE_ALIAS:-codex.internal}"
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:4500/readyz >/dev/null || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    security_opt:
      - no-new-privileges:true

networks:
  app-net:
    external: true
    name: "${CODEX_NETWORK_NAME:-app-net}"
