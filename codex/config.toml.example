# Copy this file to home/config.toml and replace the example provider and model.
check_for_update_on_startup = false
model_provider = "gateway"
model = "<model-id-supported-by-your-gateway>"

[model_providers.gateway]
name = "API Gateway"
base_url = "https://api.example.com/v1"
env_key = "OPENAI_API_KEY"
wire_api = "responses"
